# find_my_car — variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=find_my_car
DB_USER=fmc
DB_PASSWORD=

# Scraper
SCRAPER_URL=http://scraper:8001

# CORS
CORS_ORIGINS=*

# IA Analysis (GitHub Models — utilise le même token que CI/CD)
GITHUB_TOKEN=ghp_...          # ton Personal Access Token GitHub
GITHUB_MODEL=gpt-4o-mini      # modèle gratuit en preview

# Paiements Stripe
# Récupère tes clés sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...        # clé secrète (jamais exposée au frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_...   # clé publique (utilisée par le frontend)
STRIPE_WEBHOOK_SECRET=whsec_...      # secret du webhook (stripe listen --forward-to ...)

# URL du frontend (utilisée pour les redirections Stripe Checkout)
FRONTEND_URL=http://localhost:3000
