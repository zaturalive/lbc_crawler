# find_my_car — variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=find_my_car
DB_USER=fmc
DB_PASSWORD=

# Scraper
SCRAPER_URL=http://scraper:8001

# CORS
CORS_ORIGINS=*

# IA Analysis
AI_PROVIDER=openai        # openai | ollama
OPENAI_API_KEY=sk-...     # requis si AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini  # modèle OpenAI
OLLAMA_URL=http://localhost:11434   # requis si AI_PROVIDER=ollama
OLLAMA_MODEL=mistral      # modèle Ollama
