# Copy to .env and fill in values
DOMAIN=find-my-car.local

# Database
DB_USER=fmc
DB_PASSWORD=changeme_strong_password
DB_ROOT_PASSWORD=changeme_root_password

# Docker Registry (self-hosted on Pi)
REGISTRY_URL=localhost:5000

# LBC Scraper
LBC_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# CORS (comma-separated origins, * for all)
CORS_ORIGINS=*

# GitHub Models API (pour l'analyse IA)
GITHUB_TOKEN=ghp_...          # ton Personal Access Token GitHub
GITHUB_MODEL=gpt-4o-mini      # modèle gratuit en preview
